{
  "expo": {
    "name": "Pnl",
    "slug": "pnl",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "pnl",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-sqlite",
      "expo-font",
      "@react-native-community/datetimepicker"
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.barmckellens.pnl",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/adaptive-icon.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "abe0f8d4-60f5-42de-8a3b-9bb33cdfbb05"
      }
    },
    "owner": "barmckellens-team"
  }
}
